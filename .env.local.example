# --- Firebase Admin (server-side only, never exposed to the browser) ---
# From Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and \n escapes exactly as they appear in the downloaded JSON key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (safe to expose — used for the shared login page) ---
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=atlantic-bar-863ce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=atlantic-bar-863ce
NEXT_PUBLIC_FIREBASE_APP_ID=1:952619166607:web:xxxxxxxxxxxx

# --- Admin access ---
# There is no separate admin login anymore — everyone signs in at /login.
# To make yourself an admin: sign in once (creates your Firestore profile),
# then in Firebase Console -> Firestore -> "users" collection -> your
# document (matches your uid) -> change "role" from "user" to "admin".
# An "Admin" link then appears in the site's nav for that account.

# --- Email notifications (Gmail SMTP) ---
# Use a Gmail account with 2-Step Verification on, then create an App Password
# at https://myaccount.google.com/apppasswords (NOT your normal password).
GMAIL_USER=yourbar@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional display name for the "From" header
GMAIL_FROM_NAME="Atlantic Lounge Bar"
# Where new-reservation and status-change notifications should be sent
RESERVATION_NOTIFY_EMAIL=you@example.com

# --- Cloudinary (admin image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
